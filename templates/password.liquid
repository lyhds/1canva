<div class="w-full max-w-sm">
  <span class="site-wordmark site-wordmark--lg">{{ settings.brand_name | default: 'CANVASRA' }}</span>
  <h1 class="mt-4 font-serif text-[30px] leading-tight text-black md:text-[36px]">{{ 'password_page.opening_soon' | t }}</h1>
  <p class="mt-3 font-mono text-[12px] leading-relaxed text-neutral-500">{{ 'password_page.intro' | t }}</p>

  {% form 'storefront_password', class: 'mt-8 text-left' %}
    {%- if form.errors -%}
      <p class="mb-3 font-mono text-[12px] text-black" role="alert">{{ 'password_page.wrong_password' | t }}</p>
    {%- endif -%}
    <label for="Password" class="sr-only">{{ 'password_page.password' | t }}</label>
    <input
      type="password"
      name="password"
      id="Password"
      required
      autocomplete="current-password"
      placeholder="{{ 'password_page.password' | t }}"
      class="h-12 w-full border border-neutral-200 bg-white px-4 font-mono text-[13px] text-black placeholder:text-neutral-400 focus:border-black focus:outline-none"
    >
    <button
      type="submit"
      class="mt-3 h-12 w-full bg-black font-mono text-[13px] text-white transition-opacity hover:opacity-80"
    >
      {{ 'password_page.enter' | t }}
    </button>
  {% endform %}
</div>
