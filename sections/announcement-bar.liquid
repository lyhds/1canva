<script src="{{ 'announcement-bar.js' | asset_url }}" defer></script>

{%- liquid
  assign show_bar = false
  if section.blocks.size > 0 or section.settings.text != blank
    assign show_bar = true
  endif
-%}
{%- if show_bar -%}
  <aside class="relative bg-black text-white" data-announcement aria-label="{{ 'sections.announcement' | t }}">
    <div class="mx-auto grid min-h-9 max-w-[1400px] items-center px-5">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <p
            class="col-start-1 row-start-1 min-w-0 py-2 text-center font-sans text-[12px] uppercase tracking-[0.06em] [overflow-wrap:anywhere] transition-opacity duration-500{% if forloop.first %} opacity-100{% else %} pointer-events-none opacity-0{% endif %}"
            data-announcement-message
            {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="hover:underline hover:underline-offset-4">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      {%- else -%}
        <p class="min-w-0 py-2 text-center font-sans text-[12px] uppercase tracking-[0.06em] [overflow-wrap:anywhere]">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "公告栏",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "默认消息（未添加消息块时显示）",
      "default": "Hand-painted to order — complimentary insured shipping"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "消息",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "文字",
          "default": "Hand-painted to order — complimentary insured shipping"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接（可选）"
        }
      ]
    }
  ]
}
{% endschema %}
