<div class="px-5 py-16 md:px-10 md:py-24">
  <div class="mx-auto max-w-sm">
    <h1 class="font-serif text-[32px] text-black">{{ 'customer.register.title' | t }}</h1>
    <p class="mt-4 font-serif text-[17px] leading-[1.5] text-black">{{ 'customer.register.intro' | t }}</p>

    {%- form 'create_customer', class: 'mt-8 space-y-5' -%}
      {%- if form.errors -%}
        <ul class="space-y-1 border border-neutral-200 bg-neutral-50 p-4 font-sans text-[14px] text-black">
          {%- for field in form.errors -%}
            <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div>
        <label for="register-name" class="mb-2 block font-sans text-[14px] text-black">{{ 'customer.name' | t }}</label>
        <input id="register-name" type="text" name="customer[first_name]" required autocomplete="given-name" class="h-12 w-full border border-neutral-300 bg-white px-4 font-sans text-[16px] text-black outline-hidden focus:border-black md:text-[16px]">
      </div>
      <div>
        <label for="register-email" class="mb-2 block font-sans text-[14px] text-black">{{ 'customer.email' | t }}</label>
        <input id="register-email" type="email" name="customer[email]" required autocomplete="email" class="h-12 w-full border border-neutral-300 bg-white px-4 font-sans text-[16px] text-black outline-hidden focus:border-black md:text-[16px]">
      </div>
      <div>
        <label for="register-password" class="mb-2 block font-sans text-[14px] text-black">{{ 'customer.password' | t }}</label>
        <input id="register-password" type="password" name="customer[password]" required autocomplete="new-password" class="h-12 w-full border border-neutral-300 bg-white px-4 font-sans text-[16px] text-black outline-hidden focus:border-black md:text-[16px]">
      </div>
      <button type="submit" class="h-[52px] w-full bg-black font-sans text-[14px] text-white transition-opacity hover:opacity-80">
        {{ 'customer.register.submit' | t }}
      </button>
    {%- endform -%}

    <p class="mt-8 font-sans text-[14px] text-neutral-500">
      {{ 'customer.register.have_account' | t }}
      <a href="{{ routes.account_login_url }}" class="text-black underline-offset-4 hover:underline">
        {{ 'customer.login.title' | t }}
      </a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "注册",
  "settings": []
}
{% endschema %}
