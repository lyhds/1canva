<script src="{{ 'cart.js' | asset_url }}" defer></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

<cart-drawer class="block" aria-hidden="true">
  <div data-cart-drawer-scrim class="fixed inset-0 z-[70] bg-black/30 opacity-0 invisible transition-opacity duration-300"></div>

  <div
    data-cart-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.title' | t }}"
    class="fixed inset-y-0 right-0 z-[71] flex w-full max-w-md translate-x-full flex-col bg-white shadow-xl invisible transition-[transform,visibility] duration-300"
  >
    <div class="flex flex-none items-center justify-between border-b border-neutral-100 px-5 py-4">
      <h2 class="flex items-baseline gap-2 font-serif text-[22px] text-black">
        {{ 'cart.title' | t }}
        <span data-cart-count class="font-sans text-[13px] font-normal text-black" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </h2>
      <button
        type="button"
        data-cart-drawer-close
        aria-label="{{ 'general.close' | t }}"
        class="-m-2 p-2 text-black transition-opacity hover:opacity-50"
      >
        {% render 'icon', name: 'x', class: 'h-[18px] w-[18px]' %}
      </button>
    </div>

    <div
      class="flex min-h-0 flex-1 flex-col"
      data-cart-section="{{ section.id }}"
      data-updating-text="{{ 'cart.updating' | t | escape }}"
      data-updated-text="{{ 'cart.updated' | t: count: cart.item_count, total: cart.total_price | money_with_currency | escape }}"
    >
      {%- if cart.item_count == 0 -%}
        <div class="flex flex-1 flex-col items-start justify-center px-6">
          <p class="font-sans text-[14px] text-neutral-500">{{ 'cart.empty' | t }}</p>
          <a
            href="{{ routes.all_products_collection_url }}"
            class="mt-6 inline-block border border-black px-8 py-3.5 font-sans text-[14px] text-black transition-colors hover:bg-black hover:text-white"
          >
            {{ 'cart.continue' | t }}
          </a>
        </div>
      {%- else -%}
        <div class="min-h-0 flex-1 overflow-y-auto px-5 py-5">
          {%- assign threshold = settings.free_shipping_threshold -%}
          {%- if threshold > 0 -%}
            {%- assign remaining = threshold | minus: cart.total_price -%}
            <div class="mb-6">
              {%- if remaining > 0 -%}
                {%- capture remaining_money -%}<span data-display-money data-cents="{{ remaining }}">{{ remaining | money_with_currency }}</span>{%- endcapture -%}
                <p class="font-sans text-[13px] text-black">{{ 'cart.free_shipping_away' | t: amount: remaining_money }}</p>
                {%- assign percent = cart.total_price | times: 100 | divided_by: threshold -%}
              {%- else -%}
                <p class="font-sans text-[13px] text-black">{{ 'cart.free_shipping_unlocked' | t }}</p>
                {%- assign percent = 100 -%}
              {%- endif -%}
              <div class="mt-2.5 h-[3px] w-full bg-neutral-200">
                <div class="h-full bg-black transition-[width] duration-300" style="width: {{ percent }}%"></div>
              </div>
            </div>
          {%- endif -%}

          <div class="space-y-6">
            {%- for item in cart.items -%}
              {%- liquid
                capture size_frame_slots
                  render 'size-frame-slots', product: item.product, variant: item.variant
                endcapture
                assign size_frame_slots = size_frame_slots | strip | split: '|'
                assign size_found = size_frame_slots[0]
                assign frame_found = size_frame_slots[1]
                assign size_val = size_frame_slots[4]
                assign frame_val = size_frame_slots[5]
                assign master = item.product.media | where: 'alt', 'master' | first
                if master == blank
                  assign master = item.image
                endif
                capture aspect
                  render 'product-aspect', product: item.product
                endcapture
              -%}
              <div class="flex min-w-0 gap-4" data-cart-item data-cart-key="{{ item.key | escape }}">
                {%- if master != blank -%}
                  <a href="{{ item.url }}" class="flex-none">
                    {% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: item.title, sizes: '64px', class: 'h-20 w-16' %}
                  </a>
                {%- endif -%}
                <div class="flex min-w-0 flex-1 flex-col items-start gap-2.5">
                  <div class="min-w-0 w-full space-y-1 [overflow-wrap:anywhere]">
                    <a href="{{ item.url }}" data-cart-item-link class="block font-sans text-[13px] leading-snug text-black">{{ item.product.title }}</a>
                    <p class="font-sans text-[12px] text-neutral-500">
                      {%- if size_found -%}{{ size_val }}{%- endif -%}
                      {%- if size_found and frame_found %} · {% endif -%}
                      {%- if frame_found -%}{{ frame_val }}{%- endif -%}
                    </p>
                  </div>
                  <div class="flex w-full flex-none items-center justify-between gap-3">
                    <div class="inline-flex h-8 items-center border border-neutral-200">
                      <button
                        type="button"
                        data-cart-change="decrease"
                        data-quantity="{{ item.quantity | minus: 1 }}"
                        aria-label="{{ 'cart.decrease' | t }}"
                        class="flex h-full w-8 items-center justify-center text-black transition-opacity hover:opacity-50"
                      >
                        {% render 'icon', name: 'minus', class: 'h-3 w-3' %}
                      </button>
                      <span class="w-7 text-center font-sans text-[13px] text-black">{{ item.quantity }}</span>
                      <button
                        type="button"
                        data-cart-change="increase"
                        data-quantity="{{ item.quantity | plus: 1 }}"
                        aria-label="{{ 'cart.increase' | t }}"
                        class="flex h-full w-8 items-center justify-center text-black transition-opacity hover:opacity-50"
                      >
                        {% render 'icon', name: 'plus', class: 'h-3 w-3' %}
                      </button>
                    </div>
                    <div class="flex items-center gap-2.5">
                      <p class="font-sans text-[13px] font-medium text-black"><span data-display-money data-cents="{{ item.final_line_price }}">{{ item.final_line_price | money_with_currency }}</span></p>
                      <button
                        type="button"
                        data-cart-change="remove"
                        data-quantity="0"
                        aria-label="{{ 'cart.remove' | t }}"
                        class="text-black transition-opacity hover:opacity-50"
                      >
                        {% render 'icon', name: 'x', class: 'h-3.5 w-3.5' %}
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="flex-none border-t border-neutral-100 px-5 py-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-sans text-[14px] text-black">{{ 'cart.subtotal' | t }}</span>
            <span class="font-sans text-[14px] font-medium text-black" data-display-money data-cents="{{ cart.total_price }}">{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="mt-2 font-sans text-[12px] leading-relaxed text-neutral-500">{{ 'cart.taxes_note' | t }}</p>
          <p class="mt-1 font-sans text-[12px] leading-relaxed text-neutral-500">{{ 'currency.checkout_notice' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button
              type="submit"
              name="checkout"
              class="mt-4 flex h-[48px] w-full items-center justify-center bg-black font-sans text-[14px] text-white transition-opacity hover:opacity-80"
            >
              {{ 'cart.checkout' | t }}
            </button>
          </form>
          <a
            href="{{ routes.cart_url }}"
            class="mt-3 block text-center font-sans text-[13px] text-black underline-offset-4 transition-opacity hover:opacity-60 hover:underline"
          >
            {{ 'cart.view_cart' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "购物车抽屉",
  "settings": []
}
{% endschema %}
