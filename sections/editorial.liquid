{%- liquid
  assign blog = blogs[section.settings.blog]
  assign count = section.settings.articles_count
  assign has_articles = false
  if blog != blank and blog.articles.size > 0
    assign has_articles = true
  endif
-%}

{%- comment -%}
  With no published article the section renders nothing at all: three grey placeholder
  cards on a live storefront read as broken content. The theme editor keeps the
  preview so the section can still be selected and configured.
{%- endcomment -%}
{%- if has_articles or request.design_mode -%}
<section class="px-5 pb-16 md:px-10 md:pb-24">
  <div class="flex items-end justify-between gap-5">
    <h2 class="font-serif text-[28px] text-black md:text-[32px]">{{ section.settings.heading }}</h2>
    {%- if has_articles -%}
      <a href="{{ blog.url }}" class="flex-none font-sans text-[13px] uppercase tracking-[0.14em] text-black underline-offset-4 hover:underline">
        {{ section.settings.view_all_label | default: 'View all journal' }} <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
  <div
    class="scrollbar-hide -mx-5 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-px-5 px-5 pb-1 md:mx-0 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:px-0 md:pb-0"
    role="region"
    aria-label="{{ section.settings.heading | escape }}"
    tabindex="0"
  >
    {%- if has_articles -%}
      {%- for article in blog.articles limit: count -%}
        {%- liquid
          assign word_count = article.content | strip_html | split: ' ' | size
          assign reading_minutes = word_count | plus: 199 | divided_by: 200
          assign article_label = article.tags.first | default: 'Journal'
        -%}
        <a href="{{ article.url }}" class="group w-[85%] flex-none snap-start sm:w-[45%] md:w-auto">
          <div class="aspect-[4/3] w-full overflow-hidden bg-[#f3f3f3]">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 800 }}"
                srcset="{{ article.image | image_url: width: 480 }} 480w, {{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 768px) 33vw, 85vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                loading="lazy"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
              >
            {%- endif -%}
          </div>
          <p class="mt-4 font-mono text-[12px] uppercase tracking-[0.14em] text-neutral-500">
            {{ article_label }} · {{ reading_minutes }} min read
          </p>
          <h3 class="mt-2 font-serif text-[20px] leading-snug text-black">{{ article.title }}</h3>
          <p class="mt-2 font-sans text-[16px] leading-relaxed text-neutral-600">
            {{ article.excerpt_or_content | strip_html | truncate: 110 }}
          </p>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}Theme editor only: the section is hidden on a live storefront when it has no article.{%- endcomment -%}
      {%- for i in (1..3) -%}
        <div>
          <div class="aspect-[4/3] w-full bg-[#f3f3f3]">{{ 'image' | placeholder_svg_tag: 'h-full w-full bg-neutral-100' }}</div>
          <p class="mt-4 font-mono text-[12px] uppercase tracking-[0.14em] text-neutral-500">Journal</p>
          <h3 class="mt-2 font-serif text-[20px] leading-snug text-black">{{ 'sections.editorial.placeholder_title' | t }}</h3>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "专栏文章",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "From the journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "博客",
      "info": "自动显示最新文章，可在「在线商店 → 博客文章」中创建博客。"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "查看全部文字",
      "default": "View all journal"
    },
    {
      "type": "range",
      "id": "articles_count",
      "label": "显示文章数",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "专栏文章"
    }
  ]
}
{% endschema %}
