<div class="px-5 py-12 md:px-10 md:py-16">
  <div class="max-w-xl">
    <h1 class="font-serif text-[32px] text-black md:text-[36px]">{{ page.title }}</h1>
    {%- if page.content != blank -%}
      <div class="rte mt-6 font-sans text-[16px] leading-[1.8] text-neutral-600">{{ page.content }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'mt-10 space-y-5' -%}
      {%- if form.posted_successfully? -%}
        <p class="border border-neutral-200 bg-neutral-50 p-4 font-sans text-[14px] text-black">
          {{ 'contact.success' | t }}
        </p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="border border-neutral-200 bg-neutral-50 p-4 font-sans text-[14px] text-black">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
      <div>
        <label for="contact-name" class="mb-2 block font-sans text-[14px] text-black">{{ 'contact.name' | t }}</label>
        <input id="contact-name" type="text" name="contact[name]" autocomplete="name" class="h-12 w-full border border-neutral-300 bg-white px-4 font-sans text-[16px] text-black outline-hidden focus:border-black md:text-[16px]">
      </div>
      <div>
        <label for="contact-email" class="mb-2 block font-sans text-[14px] text-black">{{ 'contact.email' | t }}</label>
        <input id="contact-email" type="email" name="contact[email]" required autocomplete="email" class="h-12 w-full border border-neutral-300 bg-white px-4 font-sans text-[16px] text-black outline-hidden focus:border-black md:text-[16px]">
      </div>
      <div>
        <label for="contact-message" class="mb-2 block font-sans text-[14px] text-black">{{ 'contact.message' | t }}</label>
        <textarea id="contact-message" name="contact[body]" required rows="6" class="w-full border border-neutral-300 bg-white p-4 font-sans text-[16px] text-black outline-hidden focus:border-black md:text-[16px]"></textarea>
      </div>
      <button type="submit" class="h-[52px] w-full bg-black font-sans text-[14px] text-white transition-opacity hover:opacity-80">
        {{ 'contact.send' | t }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "联系表单",
  "settings": []
}
{% endschema %}
