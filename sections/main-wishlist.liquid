<script src="{{ 'wishlist-page.js' | asset_url }}" defer></script>

<div class="px-5 py-12 md:px-10" data-wishlist-page data-unavailable-text="{{ 'wishlist.unavailable' | t | escape }}" data-error-text="{{ 'wishlist.error' | t | escape }}" data-remove-text="{{ 'wishlist.remove' | t | escape }}" data-from-price="{{ 'products.product.from_price_html' | t: price: '__PRICE__' | escape }}">
  <h1 tabindex="-1" data-wishlist-heading class="flex items-baseline gap-2.5 font-serif text-[32px] text-black md:text-[36px]">
    {{ page.title | default: 'Wishlist' }}
    <span data-wishlist-page-count class="font-sans text-[14px] font-normal text-black"></span>
  </h1>

  <div class="mt-4 font-sans text-[14px] text-black" role="status" aria-live="polite" aria-atomic="true">
    <p data-wishlist-loading hidden>{{ 'wishlist.loading' | t }}</p>
    <p data-wishlist-error hidden>{{ 'wishlist.error' | t }}</p>
  </div>
  <button type="button" data-wishlist-retry hidden class="mt-3 min-h-11 border border-black px-5 py-2 font-sans text-[14px] text-black">{{ 'wishlist.retry' | t }}</button>

  <div data-wishlist-empty class="mt-10 hidden">
    <p class="font-sans text-[14px] text-neutral-500">{{ 'wishlist.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="mt-6 inline-block border border-black px-8 py-3.5 font-sans text-[14px] text-black transition-colors hover:bg-black hover:text-white">
      {{ 'wishlist.discover' | t }}
    </a>
  </div>

  <div data-wishlist-grid class="mt-10 grid min-w-0 grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 xl:grid-cols-4"></div>
</div>

{%- comment -%} Legacy id → handle map; new wishlist entries store handles directly. {%- endcomment -%}
<script type="application/json" data-wishlist-handle-map>
  {
    {%- paginate collections.all.products by 250 -%}
      {%- for product in collections.all.products -%}
        {%- assign product_id_key = product.id | append: '' -%}
        {{ product_id_key | json }}: {{ product.handle | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endpaginate -%}
  }
</script>

{% schema %}
{
  "name": "心愿单",
  "settings": []
}
{% endschema %}
