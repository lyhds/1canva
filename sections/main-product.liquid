<script src="{{ 'frame-preview.js' | asset_url }}" defer></script>
<script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'variant-picker.js' | asset_url }}" defer></script>
<script src="{{ 'sticky-atc.js' | asset_url }}" defer></script>
<script src="{{ 'option-sheet.js' | asset_url }}" defer></script>
<script src="{{ 'lightbox.js' | asset_url }}" defer></script>
<script src="{{ 'modal.js' | asset_url }}" defer></script>
<script src="{{ 'size-guide-visualizer.js' | asset_url }}" defer></script>
<script src="{{ 'delivery-estimate.js' | asset_url }}" defer></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  if product.selected_variant == blank
    capture default_variant_id
      render 'default-oak-variant', product: product
    endcapture
    assign default_variant_id = default_variant_id | strip | plus: 0
    assign current_variant = product.variants | where: 'id', default_variant_id | first
  endif
  capture size_frame_slots
    render 'size-frame-slots', product: product, variant: current_variant
  endcapture
  assign size_frame_slots = size_frame_slots | strip | split: '|'
  assign size_found = size_frame_slots[0]
  assign frame_found = size_frame_slots[1]
  assign size_idx = size_frame_slots[2] | plus: 0
  assign frame_idx = size_frame_slots[3] | plus: 0
  assign size_val = size_frame_slots[4]
  assign frame_val = size_frame_slots[5]
  assign master = product.media | where: 'alt', 'master' | first
  if master == blank
    assign master = product.featured_media
  endif
  assign desktop_scene = product.media | where: 'alt', 'composed-framed-scene-desktop-v1' | where: 'media_type', 'image' | first
  unless desktop_scene
  assign desktop_scene = product.media | where: 'alt', 'composed-unframed-scene-desktop-v1' | where: 'media_type', 'image' | first
  endunless
  unless desktop_scene
  assign desktop_scene = product.media | where: 'alt', 'scene-room-desktop-v3' | where: 'media_type', 'image' | first
  endunless
  unless desktop_scene
    assign desktop_scene = product.media | where: 'alt', 'scene-room-desktop-v2' | where: 'media_type', 'image' | first
  endunless
  unless desktop_scene
    assign desktop_scene = product.media | where: 'alt', 'scene-room-desktop-v1' | where: 'media_type', 'image' | first
  endunless
  assign gallery_lead = product.media | where: 'alt', 'composed-framed-scene-3-v1' | where: 'media_type', 'image' | first
  unless gallery_lead
  assign gallery_lead = product.media | where: 'alt', 'composed-unframed-scene-3-v1' | where: 'media_type', 'image' | first
  endunless
  unless gallery_lead
  assign gallery_lead = product.media | where: 'alt', 'scene-room-large-v2' | where: 'media_type', 'image' | first
  endunless
  unless gallery_lead
    assign gallery_lead = product.media | where: 'alt', 'scene-room-large-v1' | where: 'media_type', 'image' | first
  endunless
  assign gallery_lead = gallery_lead | default: master
  assign gallery_remaining = '' | split: ','
  if gallery_lead.id != master.id
    assign gallery_remaining = product.media | where: 'id', master.id
  endif
  for media_item in product.media
    if media_item.media_type == 'image' and media_item.id != master.id and media_item.id != gallery_lead.id and media_item.id != desktop_scene.id
      assign one_media = product.media | where: 'id', media_item.id
      assign gallery_remaining = gallery_remaining | concat: one_media
    endif
  endfor
  capture aspect
    render 'product-aspect', product: product
  endcapture
  assign aspect = aspect | strip
  assign slide_count = 0
  for m in product.media
    if m.media_type == 'image' and m.id != desktop_scene.id
      assign slide_count = slide_count | plus: 1
    endif
  endfor
-%}

{%- if desktop_scene != blank -%}
  <div data-desktop-product-hero>
    {% render 'artwork-scene', scene_layouts: product.metafields.custom.scene_layouts.value, room: desktop_scene, master: master, aspect: aspect, frame: frame_val, alt: product.title, loading: 'eager' %}
    <a href="#ProductPurchase-{{ section.id }}" class="desktop-product-intro">
      <img src="{{ master | image_url: width: 120 }}" alt="" width="{{ master.width }}" height="{{ master.height }}">
      <span><strong>{{ product.title | escape }}</strong><span data-main-price>{{ current_variant.price | money }}</span></span>
      {% render 'icon', name: 'chevron-down', class: 'h-4 w-4' %}
    </a>
  </div>
{%- endif -%}
<div id="ProductPurchase-{{ section.id }}" {% if desktop_scene != blank %}data-responsive-product{% endif %} class="w-full min-w-0 px-5 pb-8 pt-0 md:px-10 lg:pt-8">
  {%- liquid
  assign breadcrumb_collection = collection | default: product.collections.first
-%}
<nav data-product-breadcrumb class="pb-4 pt-3 font-sans text-[13px] text-neutral-500 lg:pb-6 lg:pt-0" aria-label="{{ 'general.breadcrumb' | t }}">
  <ol class="flex flex-nowrap items-center gap-x-1.5 whitespace-nowrap">
    <li class="flex-none">
      <a href="{{ routes.root_url }}" class="transition-colors hover:text-black">{{ 'general.home' | t }}</a>
    </li>
    {%- if breadcrumb_collection -%}
      <li class="flex-none" aria-hidden="true">/</li>
      <li class="flex-none">
        <a href="{{ breadcrumb_collection.url }}" class="transition-colors hover:text-black">{{ breadcrumb_collection.title }}</a>
      </li>
    {%- endif -%}
    <li class="flex-none" aria-hidden="true">/</li>
    <li class="min-w-0 flex-1" aria-current="page">
      <span class="block truncate text-neutral-600">{{ product.title }}</span>
    </li>
  </ol>
</nav>

<div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-10 lg:mx-auto lg:max-w-[1400px] lg:grid-cols-2 lg:gap-14 xl:grid-cols-[minmax(0,1fr)_minmax(440px,540px)]">
    {%- comment -%} left: gallery {%- endcomment -%}
    <div class="min-w-0">
      <product-gallery {% if desktop_scene != blank and gallery_lead.id != master.id %}data-desktop-skip-lead{% endif %} class="group block min-w-0 max-w-full lg:grid lg:grid-cols-[72px_minmax(0,1fr)] lg:items-start lg:gap-4">
        <div class="relative -mx-5 w-[calc(100%+2.5rem)] min-w-0 md:-mx-10 md:w-[calc(100%+5rem)] lg:order-2 lg:mx-0 lg:w-auto">
          <div
            data-gallery-track
            class="scrollbar-hide flex w-full min-w-0 max-w-full snap-x snap-mandatory overflow-x-auto"
            style="--desktop-gallery-ratio: {{ section.settings.gallery_ratio }};"
          >
            {%- if master != blank -%}
              <button type="button" data-gallery-slide aria-label="{{ 'products.product.open_viewer' | t }}" class="block h-full w-full flex-none cursor-zoom-in snap-start">
                {% if gallery_lead.id != master.id %}{% render 'artwork-scene', scene_layouts: product.metafields.custom.scene_layouts.value, room: gallery_lead, master: master, aspect: aspect, frame: frame_val, alt: product.title, thumbnail: false, loading: 'eager' %}{% else %}<frame-preview aspect="{{ aspect }}" class="product-gallery-frame block h-full w-full">
                  {% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: product.title, sizes: '(min-width: 1024px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'h-full w-full' %}
                </frame-preview>{% endif %}
              </button>
            {%- else -%}
              <div class="block h-full w-full flex-none snap-start">
                <div class="flex h-full w-full items-center justify-center bg-[#f3f3f3]">
                  {{ 'image' | placeholder_svg_tag: 'h-1/2 w-1/2 bg-neutral-100' }}
                </div>
              </div>
            {%- endif -%}
            {%- comment -%} Details fill the responsive gallery; original artwork and room compositions retain their ratios. {%- endcomment -%}
            {%- for m in gallery_remaining -%}
              {%- if m.media_type != 'image' -%}
                {%- continue -%}
              {%- endif -%}
              <button type="button" data-gallery-slide aria-label="{{ 'products.product.open_viewer' | t }}" class="block h-full w-full flex-none cursor-zoom-in snap-start">
                {%- if m.id == master.id -%}<frame-preview class="block h-full w-full">{% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: product.title, class: 'h-full w-full' %}</frame-preview>{%- elsif m.alt == 'scene-room-v1' or m.alt == 'scene-room-large-v1' or m.alt == 'scene-room-large-v2' or m.alt contains 'composed-unframed-' or m.alt contains 'composed-framed-' -%}
                  {% render 'artwork-scene', scene_layouts: product.metafields.custom.scene_layouts.value, room: m, master: master, aspect: aspect, frame: frame_val, alt: product.title %}
                {%- else -%}
                  <div class="h-full w-full overflow-hidden bg-[#f3f3f3]">
                    <img src="{{ m | image_url: width: 1200 }}" alt="{{ m.alt | default: product.title | escape }}" class="h-full w-full object-contain" loading="lazy" width="{{ m.width }}" height="{{ m.height }}">
                  </div>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>

          <span data-gallery-count aria-live="polite"></span>
          {%- if slide_count > 1 -%}
            <button type="button" data-gallery-prev aria-label="{{ 'products.product.previous_image' | t }}" class="absolute left-3 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-black opacity-0 shadow-sm backdrop-blur-xs transition-opacity duration-200 hover:bg-white group-hover:opacity-100 lg:flex" style="display:none">
              {% render 'icon', name: 'chevron-left', class: 'h-4 w-4' %}
            </button>
            <button type="button" data-gallery-next aria-label="{{ 'products.product.next_image' | t }}" class="absolute right-3 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-black opacity-0 shadow-sm backdrop-blur-xs transition-opacity duration-200 hover:bg-white group-hover:opacity-100 lg:flex">
              {% render 'icon', name: 'chevron-right', class: 'h-4 w-4' %}
            </button>

            <div class="absolute inset-x-0 bottom-4 z-10 flex justify-center lg:hidden">
              <div class="flex items-center" role="group" aria-label="{{ product.title | escape }}">
                <button type="button" data-gallery-thumb data-gallery-dot data-gallery-index="0" aria-current="true" aria-label="{{ 'products.product.show_image' | t: index: 1 }}" class="flex h-5 w-5 items-center justify-center">
                  <span data-gallery-marker class="h-2 w-2 rounded-full bg-black transition-colors"></span>
                </button>
                {%- assign dot_index = 2 -%}
                {%- for m in gallery_remaining -%}
                  {%- if m.media_type != 'image' -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- assign gallery_index = dot_index | minus: 1 -%}
                  <button type="button" data-gallery-thumb data-gallery-dot data-gallery-index="{{ gallery_index }}" aria-current="false" aria-label="{{ 'products.product.show_image' | t: index: dot_index }}" class="flex h-5 w-5 items-center justify-center">
                    <span data-gallery-marker class="h-2 w-2 rounded-full bg-black/25 transition-colors"></span>
                  </button>
                  {%- assign dot_index = dot_index | plus: 1 -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if slide_count > 1 -%}
          <div class="scrollbar-hide mt-3 hidden max-w-full gap-2 overflow-x-auto pb-1 lg:order-1 lg:mt-0 lg:flex lg:flex-col lg:overflow-visible lg:pb-0">
            <button type="button" data-gallery-thumb data-gallery-index="0" aria-current="true" aria-label="{{ 'products.product.show_image' | t: index: 1 }}" class="h-16 w-16 flex-none overflow-hidden border border-black transition-colors lg:aspect-square lg:h-auto lg:w-full">
              {% if gallery_lead.id != master.id %}{% render 'artwork-scene', scene_layouts: product.metafields.custom.scene_layouts.value, room: gallery_lead, master: master, aspect: aspect, frame: frame_val, alt: product.title, thumbnail: true, loading: 'eager' %}{% else %}<frame-preview aspect="{{ aspect }}" class="block h-full w-full">
                {% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: '', sizes: '72px', class: 'h-full w-full' %}
              </frame-preview>{% endif %}
            </button>
            {%- assign t_index = 2 -%}
            {%- for m in gallery_remaining -%}
              {%- if m.media_type != 'image' -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign gallery_index = t_index | minus: 1 -%}
              <button type="button" data-gallery-thumb data-gallery-index="{{ gallery_index }}" aria-current="false" aria-label="{{ 'products.product.show_image' | t: index: t_index }}" class="h-16 w-16 flex-none overflow-hidden border border-black/15 transition-colors hover:border-black/40 lg:aspect-square lg:h-auto lg:w-full">
                {%- if m.id == master.id -%}<frame-preview class="block h-full w-full">{% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: product.title, class: 'h-full w-full' %}</frame-preview>{%- elsif m.alt == 'scene-room-v1' or m.alt == 'scene-room-large-v1' or m.alt == 'scene-room-large-v2' or m.alt contains 'composed-unframed-' -%}
                  {% render 'artwork-scene', scene_layouts: product.metafields.custom.scene_layouts.value, room: m, master: master, aspect: aspect, frame: frame_val, alt: '', thumbnail: true %}
                {%- else -%}
                  <img src="{{ m | image_url: width: 300 }}" alt="" class="h-full w-full bg-[#f3f3f3] object-cover" loading="lazy" width="{{ m.width }}" height="{{ m.height }}">
                {%- endif -%}
              </button>
              {%- assign t_index = t_index | plus: 1 -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </product-gallery>
    </div>

    {%- comment -%} right: purchase panel {%- endcomment -%}
    <div class="min-w-0">
      <div class="min-w-0 lg:sticky lg:top-24 lg:max-w-[540px]">
        <h1 class="font-serif text-[28px] leading-[1.2] text-black md:text-[32px]">{{ product.title }}</h1>
        {%- comment -%} rating link (only when verified reviews are explicitly enabled) {%- endcomment -%}
        {%- if settings.enable_customer_reviews -%}
          {%- assign review_refs = product.metafields.custom.reviews.value -%}
          {%- if review_refs != blank -%}
          {%- assign r_count = 0 -%}
          {%- assign r_sum = 0 -%}
          {%- for r in review_refs -%}
            {%- if r.rating -%}
              {%- assign r_count = r_count | plus: 1 -%}
              {%- assign r_sum = r_sum | plus: r.rating -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if r_count > 0 -%}
            {%- assign r_avg = r_sum | times: 1.0 | divided_by: r_count | round: 1 -%}
            {%- assign r_frac = r_avg | modulo: 1 -%}
            <a href="#reviews" class="mt-3 inline-flex items-center gap-2">
              {% render 'stars', rating: r_avg, size: 14 %}
              <span class="font-sans text-[14px] text-neutral-500 underline-offset-4 transition-colors hover:underline">
                {%- if r_frac == 0 -%}{{ r_avg | round }}{%- else -%}{{ r_avg }}{%- endif -%}
                · {{ 'products.reviews.count' | t: count: r_count }}
              </span>
            </a>
          {%- endif -%}
          {%- endif -%}
        {%- endif -%}
        {%- liquid
          assign cv = current_variant
          assign on_sale = false
          if cv.compare_at_price > cv.price
            assign on_sale = true
            assign save_diff = cv.compare_at_price | minus: cv.price
            assign save_pct = save_diff | times: 100.0 | divided_by: cv.compare_at_price | round
          endif
        -%}
        <p class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-sans text-[20px] leading-[1.4] text-black">
          <s data-main-compare class="text-neutral-400{% unless on_sale %} hidden{% endunless %}">{% if on_sale %}<span data-display-money data-cents="{{ cv.compare_at_price }}">{{ cv.compare_at_price | money }}</span>{% endif %}</s>
          <span data-main-price class="{% if on_sale %}text-black{% endif %}"><span data-display-money data-cents="{{ cv.price }}">{{ cv.price | money }}</span></span>
          <span data-framed-note class="text-[14px] text-neutral-600 {% unless frame_val contains 'Float Frame' %}hidden{% endunless %}">· {{ 'products.product.framed_note' | t }}</span>
        </p>

        <div class="product-sale-banner" data-sale-banner {% unless on_sale %}hidden{% endunless %}>
          <div class="product-sale-banner-copy">
            <span class="product-sale-banner-tagline">Gallery at home</span>
            <strong><span data-sale-banner-percent>{{ save_pct }}</span><span class="product-sale-banner-unit"><span>%</span><span>OFF</span></span></strong>
          </div>
          <img src="{{ 'sale-banner-living-room.png' | asset_url }}" alt="" width="960" height="411" loading="lazy">
        </div>

        <variant-picker
          class="block min-w-0"
          data-aspect="{{ aspect }}"
          data-rolled-only-notice="{{ 'products.product.rolled_only_notice' | t | escape }}"
          data-add-text="{{ 'products.product.add_to_cart' | t }}"
          data-sold-out-text="{{ 'products.product.sold_out' | t }}"
          data-unavailable-text="{{ 'products.product.unavailable' | t }}"
        >
          <form action="{{ routes.cart_add_url }}" method="post" accept-charset="UTF-8" enctype="multipart/form-data" class="min-w-0">
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">

            {%- comment -%} mobile: selector rows that open bottom sheets {%- endcomment -%}
            <div class="lg:hidden">
              <div class="mt-7">
                {%- if size_found -%}
                  <div class="relative">
                    <button type="button" data-modal-open="size-guide-{{ product.id }}" class="absolute -top-7 right-0 py-1 font-sans text-[14px] text-neutral-500 underline-offset-4 transition-colors hover:text-black hover:underline">
                      {{ 'products.product.size_guide' | t }}
                    </button>
                    <button
                      type="button"
                      data-sheet-open="size-sheet-{{ section.id }}"
                      class="flex w-full min-w-0 items-center justify-between gap-4 rounded-lg bg-[#f5f5f5] px-4 py-3.5"
                    >
                      <span class="font-sans text-[14px] text-black">{{ 'products.product.size' | t }}</span>
                      <span class="flex min-w-0 max-w-[75%] items-center justify-end gap-2 font-sans text-[14px]">
                        <span data-row-size-dims class="min-w-0 truncate text-right text-black">{% render 'size-label', value: size_val %}</span>
                        {% render 'icon', name: 'chevron-right', class: 'h-3.5 w-3.5 flex-none text-black' %}
                      </span>
                    </button>
                  </div>
                {%- endif -%}
                {%- if frame_found -%}
                  <button
                    type="button"
                    data-sheet-open="frame-sheet-{{ section.id }}"
                    class="{% if size_found %}mt-3 {% endif %}flex w-full min-w-0 items-center justify-between gap-4 rounded-lg bg-[#f5f5f5] px-4 py-3.5"
                  >
                    <span class="font-sans text-[14px] text-black">{{ 'products.product.frame' | t }}</span>
                    <span class="flex min-w-0 max-w-[75%] items-center justify-end gap-2 font-sans text-[14px]">
                      {%- capture row_swatch -%}{% render 'frame-swatch', frame: frame_val %}{%- endcapture -%}
                      {%- assign row_swatch = row_swatch | strip -%}
                      {%- if row_swatch != blank -%}
                        <img data-row-frame-swatch src="{{ row_swatch | asset_url }}" alt="" class="h-5 w-5 object-cover" width="96" height="96">
                      {%- else -%}
                        <img data-row-frame-swatch src="{{ 'oak-swatch.webp' | asset_url }}" alt="" class="hidden h-5 w-5 object-cover" width="96" height="96">
                      {%- endif -%}
                      <span data-row-frame-name class="truncate text-black">{{ frame_val }}</span>
                      {% render 'icon', name: 'chevron-right', class: 'h-3.5 w-3.5 text-black' %}
                    </span>
                  </button>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} size {%- endcomment -%}
            {%- comment -%} desktop: inline size list {%- endcomment -%}
            <div class="mt-7 hidden items-baseline justify-between gap-4 lg:flex">
              <p class="font-sans text-[14px] text-black">{{ 'products.product.size' | t }}</p>
              <button type="button" data-modal-open="size-guide-{{ product.id }}" class="-my-1 py-1 font-sans text-[14px] text-neutral-500 underline-offset-4 transition-colors hover:text-black hover:underline">
                {{ 'products.product.size_guide' | t }}
              </button>
            </div>
            <div class="mt-3 hidden lg:block">
              <details data-size-dropdown class="group/sizedd relative">
                <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-4 border border-neutral-200 px-4 py-3.5 transition-colors hover:border-neutral-300 [&::-webkit-details-marker]:hidden">
                  <span class="font-sans text-[14px] text-black">{{ 'products.product.size' | t }}</span>
                  <span class="flex min-w-0 items-center justify-end gap-2.5 font-sans text-[14px]">
                    <span data-row-size-dims class="min-w-0 truncate text-right text-black">{% render 'size-label', value: size_val %}</span>
                    {% render 'icon', name: 'chevron-down', class: 'h-3.5 w-3.5 flex-none text-black transition-transform duration-200 group-open/sizedd:rotate-180' %}
                  </span>
                </summary>
                <div class="absolute inset-x-0 top-full z-30 mt-1 max-h-[320px] divide-y divide-neutral-100 overflow-y-auto border border-neutral-200 bg-white shadow-xl">
                  {%- for option in product.options_with_values -%}
                    {%- assign option_name = option.name | downcase -%}{%- if option_name == 'size' -%}
                      {%- for value in option.values -%}
                        {%- capture rolled_only_id -%}{% render 'rolled-only-variant', product: product, size: value, size_idx: size_idx, frame_idx: frame_idx %}{%- endcapture -%}
                        {%- assign rolled_only_id = rolled_only_id | strip | plus: 0 -%}
                        {%- assign row_variant = product.variants | where: 'id', rolled_only_id | first -%}
                        {%- for v in product.variants -%}
                          {%- if v.options[size_idx] == value and v.options[frame_idx] == frame_val -%}
                            {%- assign row_variant = v -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <button
                          type="button"
                          data-option-button
                          data-option-name="Size"
                          data-option-value="{{ value | escape }}"
                          data-size-label="{% render 'size-label', value: value %}"
                          aria-pressed="{% if size_val == value %}true{% else %}false{% endif %}"
                          {% unless row_variant and row_variant.available %}data-soldout{% endunless %}
                          class="group/row flex w-full flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 px-4 py-3 text-left transition-colors hover:bg-neutral-50 aria-pressed:bg-neutral-50 aria-pressed:shadow-[inset_2px_0_0_0_#000] {% unless row_variant and row_variant.available %}option-soldout{% endunless %}"
                        >
                          <span class="font-sans text-[14px] text-neutral-500 group-aria-pressed/row:text-black">{% render 'size-label', value: value %}<span data-rolled-only-label class="ml-2 text-[12px] {% if rolled_only_id == 0 %}hidden{% endif %}">{{ 'products.product.rolled_only' | t }}</span></span>
                          <span class="ml-auto whitespace-nowrap font-sans text-[14px] text-black" data-size-price="{{ value | escape }}">
                            {%- if row_variant -%}<span data-display-money data-cents="{{ row_variant.price }}">{{ row_variant.price | money }}</span>{%- endif -%}
                          </span>
                        </button>
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </details>
            </div>

            {%- comment -%} frame {%- endcomment -%}
            <div class="mt-7 hidden items-baseline justify-between gap-4 lg:flex">
              <p class="font-sans text-[14px] text-black">
                {{ 'products.product.frame' | t }}:
                <span class="font-medium" data-frame-name>{{ frame_val }}</span>
              </p>
              <p class="font-sans text-[12px] text-neutral-500">Canvas delivery & framing</p>
            </div>
            <div class="mt-4 hidden grid-cols-6 gap-3 lg:grid">
              {%- for option in product.options_with_values -%}
                {%- assign option_name = option.name | downcase -%}{%- if option_name == 'frame' -%}
                  {%- for value in option.values -%}
                    {%- if value == 'Rolled Canvas' -%}{%- continue -%}{%- endif -%}
                    {%- liquid
                      assign frame_avail = false
                      capture frame_option_image
                        render 'frame-option-image', frame: value
                      endcapture
                      assign frame_option_image = frame_option_image | strip
                      for v in product.variants
                        if v.options[size_idx] == size_val and v.options[frame_idx] == value and v.available
                          assign frame_avail = true
                          break
                        endif
                      endfor

                    -%}
                    <button
                      type="button"
                      data-option-button
                      data-option-name="Frame"
                      data-option-value="{{ value | escape }}"
                      aria-pressed="{% if frame_val == value %}true{% else %}false{% endif %}"
                      {% unless frame_avail %}data-soldout{% endunless %}
                      aria-label="{{ value }}"
                      title="{{ value }}"
                      class="group/frame relative flex h-[72px] w-[72px] items-center justify-center rounded-full border-[3px] border-neutral-200 bg-white p-1 transition-colors hover:border-neutral-400 aria-pressed:border-black {% unless frame_avail %}option-soldout{% endunless %}"
                    >
                      <span class="flex h-full w-full items-center justify-center overflow-hidden rounded-full bg-[#eeece7]">
                        {%- if frame_option_image != blank -%}
                          <img src="{{ frame_option_image | asset_url }}" alt="" class="h-full w-full object-cover" loading="lazy" width="96" height="96">

                        {%- else -%}
                          <span class="block h-10 w-9 rotate-[-8deg] border border-neutral-400 bg-[#faf8f2] shadow-[3px_3px_0_#c9c5bd]" aria-hidden="true"></span>
                        {%- endif -%}
                      </span>
                      <span class="pointer-events-none absolute -bottom-8 left-1/2 z-20 hidden -translate-x-1/2 whitespace-nowrap bg-black px-2 py-1 font-sans text-[11px] text-white group-hover/frame:block">{{ value }}</span>
                    </button>
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            {% render 'rolled-canvas-choice', product: product, size_idx: size_idx, frame_idx: frame_idx, size_val: size_val, frame_val: frame_val %}
            <p data-rolled-only-notice role="status" aria-live="polite" class="mt-4 hidden font-sans text-[13px] leading-relaxed text-neutral-600"></p>
            {%- comment -%} qty + ATC + wishlist {%- endcomment -%}
            <div data-buy-row class="mt-6 grid min-w-0 grid-cols-[auto_minmax(0,1fr)_52px] gap-2 sm:flex sm:gap-3">
              <div class="inline-flex h-[52px] flex-none items-center">
                <button type="button" data-qty-change="-1" aria-label="{{ 'cart.decrease' | t }}" class="flex h-full w-8 items-center justify-center text-black transition-opacity hover:opacity-50 md:w-10">
                  {% render 'icon', name: 'minus', class: 'h-3.5 w-3.5' %}
                </button>
                <input type="text" name="quantity" value="1" data-qty-input inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}" class="w-7 border-0 bg-transparent text-center font-sans text-[16px] text-black outline-hidden md:text-[16px]">
                <button type="button" data-qty-change="1" aria-label="{{ 'cart.increase' | t }}" class="flex h-full w-8 items-center justify-center text-black transition-opacity hover:opacity-50 md:w-10">
                  {% render 'icon', name: 'plus', class: 'h-3.5 w-3.5' %}
                </button>
              </div>
              <button
                type="submit"
                data-atc
                class="flex h-[52px] min-w-0 flex-1 items-center justify-center gap-2 whitespace-nowrap bg-black px-2 font-sans text-[15px] font-medium text-white transition-opacity hover:opacity-80 sm:gap-2.5 sm:px-0 {% unless current_variant.available %}cursor-not-allowed opacity-30{% endunless %}"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {% render 'icon', name: 'bag', class: 'h-4 w-4' %}
                <span data-atc-text>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                {%- if current_variant.available -%}
                  <span data-atc-price class="hidden sm:inline">· <span data-display-money data-cents="{{ current_variant.price }}">{{ current_variant.price | money }}</span></span>
                {%- else -%}
                  <span data-atc-price></span>
                {%- endif -%}
              </button>
              <button
                type="button"
                data-wishlist-toggle="{{ product.handle }}"
                data-product-id="{{ product.id }}"
                aria-pressed="false"
                aria-label="{{ 'products.product.save' | t: title: product.title }}"
                class="flex h-[52px] w-[52px] flex-none items-center justify-center border border-neutral-300 text-black transition-colors hover:border-black"
              >
                {% render 'icon', name: 'heart', class: 'h-[18px] w-[18px]' %}
              </button>
            </div>
          </form>

          {%- comment -%} mobile bottom sheets (mirror the same data-option-button state) {%- endcomment -%}
          {%- if size_found -%}
            <option-sheet id="size-sheet-{{ section.id }}" close-on-select>
              <div data-sheet-backdrop class="invisible fixed inset-0 z-[64] bg-black/15 opacity-0 transition-opacity duration-300 lg:hidden"></div>
              <div data-sheet-panel class="invisible fixed inset-x-0 bottom-0 z-[65] translate-y-full rounded-t-2xl bg-white transition-[transform,visibility] duration-300 lg:hidden" role="dialog" aria-modal="true" aria-label="{{ 'products.product.select_size' | t }}">
                <div class="mx-auto mt-2.5 h-1 w-10 rounded-full bg-neutral-200"></div>
                <div class="flex items-center justify-between px-5 py-4">
                  <p class="font-sans text-[14px] text-black">{{ 'products.product.select_size' | t }}</p>
                  <button type="button" data-sheet-close aria-label="{{ 'general.close' | t }}" class="-m-2 p-2 text-black transition-opacity hover:opacity-50">
                    {% render 'icon', name: 'x', class: 'h-[18px] w-[18px]' %}
                  </button>
                </div>
                <div class="max-h-[60vh] overflow-y-auto px-5 pb-8">
                  {%- for option in product.options_with_values -%}
                    {%- assign option_name = option.name | downcase -%}{%- if option_name == 'size' -%}
                      {%- for value in option.values -%}
                        {%- capture rolled_only_id -%}{% render 'rolled-only-variant', product: product, size: value, size_idx: size_idx, frame_idx: frame_idx %}{%- endcapture -%}
                        {%- assign rolled_only_id = rolled_only_id | strip | plus: 0 -%}
                        {%- assign row_variant = product.variants | where: 'id', rolled_only_id | first -%}
                        {%- for v in product.variants -%}
                          {%- if v.options[size_idx] == value and v.options[frame_idx] == frame_val -%}
                            {%- assign row_variant = v -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <button
                          type="button"
                          data-option-button
                          data-option-name="Size"
                          data-option-value="{{ value | escape }}"
                          data-size-label="{% render 'size-label', value: value %}"
                          aria-pressed="{% if size_val == value %}true{% else %}false{% endif %}"
                          class="flex w-full flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 border-b border-neutral-100 py-3.5 text-left last:border-b-0 aria-pressed:bg-neutral-50 {% unless row_variant and row_variant.available %}option-soldout{% endunless %}"
                        >
                          <span class="font-sans text-[14px] text-black">{% render 'size-label', value: value %}<span data-rolled-only-label class="ml-2 text-[12px] text-neutral-500 {% if rolled_only_id == 0 %}hidden{% endif %}">{{ 'products.product.rolled_only' | t }}</span></span>
                          <span class="ml-auto shrink-0 whitespace-nowrap font-sans text-[14px] text-black" data-size-price="{{ value | escape }}">
                            {%- if row_variant -%}<span data-display-money data-cents="{{ row_variant.price }}">{{ row_variant.price | money }}</span>{%- endif -%}
                          </span>
                        </button>
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </option-sheet>
          {%- endif -%}

          {%- if frame_found -%}
            <option-sheet id="frame-sheet-{{ section.id }}">
              <div data-sheet-backdrop class="invisible fixed inset-0 z-[64] bg-black/15 opacity-0 transition-opacity duration-300 lg:hidden"></div>
              <div data-sheet-panel class="invisible fixed inset-x-0 bottom-0 z-[65] translate-y-full rounded-t-2xl bg-white transition-[transform,visibility] duration-300 lg:hidden" role="dialog" aria-modal="true" aria-label="{{ 'products.product.select_frame' | t }}">
                <div class="mx-auto mt-2.5 h-1 w-10 rounded-full bg-neutral-200"></div>
                <div class="flex items-center justify-between px-5 py-4">
                  <p class="font-sans text-[14px] text-black">{{ 'products.product.select_frame' | t }}</p>
                  <button type="button" data-sheet-close aria-label="{{ 'general.close' | t }}" class="-m-2 p-2 text-black transition-opacity hover:opacity-50">
                    {% render 'icon', name: 'x', class: 'h-[18px] w-[18px]' %}
                  </button>
                </div>
                <div class="max-h-[60vh] overflow-y-auto px-5 pb-8">
                  {%- for option in product.options_with_values -%}
                      {%- assign option_name = option.name | downcase -%}{%- if option_name == 'frame' -%}
                        {%- for value in option.values -%}
                          {%- if value == 'Rolled Canvas' -%}{%- continue -%}{%- endif -%}
                          {%- capture swatch -%}{% render 'frame-option-image', frame: value %}{%- endcapture -%}
                          {%- liquid
                            assign swatch = swatch | strip
                            assign frame_avail = false
                            for v in product.variants
                              if v.options[frame_idx] == value and v.available
                                assign frame_avail = true
                                break
                              endif
                            endfor
                          -%}
                        <button
                          type="button"
                          data-option-button
                          data-option-name="Frame"
                          data-option-value="{{ value | escape }}"
                          aria-pressed="{% if frame_val == value %}true{% else %}false{% endif %}"
                          class="group/frame flex w-full items-center justify-between gap-4 border-b border-neutral-100 py-3.5 text-left last:border-b-0 aria-pressed:bg-neutral-50 {% unless frame_avail %}option-soldout option-soldout-line{% endunless %}"
                        >
                          <span class="flex items-center gap-3">
                            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-neutral-200 p-1 group-aria-pressed/frame:border-black">
                              {%- if swatch != blank -%}
                                <img src="{{ swatch | asset_url }}" alt="" class="h-full w-full rounded-full object-cover" loading="lazy" width="96" height="96">
                              {%- endif -%}
                            </span>
                            <span class="font-sans text-[14px] text-black">{{ value }}
                              <span class="mt-1 block text-[12px] text-neutral-500">
                                {%- case value -%}
                                  {%- when 'Rolled Canvas' -%}{{ 'products.product.rolled_delivery' | t }}
                                  {%- when 'Stretched Canvas' -%}{{ 'products.product.stretched_delivery' | t }}
                                  {%- else -%}{{ 'products.product.framed_delivery' | t }}
                                {%- endcase -%}
                              </span>
                            </span>
                          </span>
                        </button>
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </option-sheet>
          {%- endif -%}

          <script type="application/json" data-variants>{{ product.variants | json }}</script>
          <script type="application/json" data-option-names>{{ product.options | json }}</script>
          <script type="application/json" data-current-variant>{{ current_variant | json }}</script>
        </variant-picker>

        {%- comment -%} delivery estimate timeline: order -> painting complete -> shipped -> arrival
             date ranges are computed client-side (delivery-estimate.js) from day
             offsets, so cached pages never show stale dates {%- endcomment -%}
        {%- if section.settings.show_delivery_estimate -%}
          {%- liquid
            assign prod_min = section.settings.production_days_min | default: 7
            assign prod_max = section.settings.production_days_max | default: 10
            assign tran_min = section.settings.transit_days_min | default: 5
            assign tran_max = section.settings.transit_days_max | default: 8
          -%}
          <div class="product-delivery-timeline">
            <ol class="grid grid-cols-3">
              <li class="relative min-w-0">
                <span class="absolute left-1/2 top-[5px] h-px w-full bg-neutral-200" aria-hidden="true"></span>
                <span class="relative mx-auto block h-[11px] w-[11px] rotate-45 bg-black" aria-hidden="true"></span>
                <p class="mt-3 min-h-[2.8em] text-center font-sans text-[14px] leading-[1.4] text-black">{{ 'products.product.delivery_step_order' | t }}</p>
                <p class="mt-1 whitespace-nowrap text-center font-sans text-[13px] text-neutral-500 sm:text-[14px]">{{ 'products.product.delivery_today' | t }}</p>
              </li>
              <li class="relative min-w-0">
                <span class="absolute left-1/2 top-[5px] h-px w-full bg-neutral-200" aria-hidden="true"></span>
                <span class="relative mx-auto block h-[11px] w-[11px] rotate-45 border border-black bg-white" aria-hidden="true"></span>
                <p class="mt-3 min-h-[2.8em] text-center font-sans text-[14px] leading-[1.4] text-black">{{ 'products.product.delivery_step_complete' | t }}</p>
                <p class="mt-1 whitespace-nowrap text-center font-sans text-[13px] text-neutral-500 sm:text-[14px]" data-delivery-range="{{ prod_min }},{{ prod_max }}"></p>
              </li>
              <li class="relative min-w-0">
                <span class="relative mx-auto block h-[11px] w-[11px] rotate-45 border border-black bg-white" aria-hidden="true"></span>
                <p class="mt-3 min-h-[2.8em] text-center font-sans text-[14px] leading-[1.4] text-black">{{ 'products.product.delivery_step_arrival' | t }}</p>
                <p class="mt-1 whitespace-nowrap text-center font-sans text-[13px] text-neutral-500 sm:text-[14px]" data-delivery-range="{{ prod_min | plus: tran_min }},{{ prod_max | plus: tran_max }}"></p>
              </li>
            </ol>
            {%- if section.settings.delivery_note != blank -%}
              <p class="mt-4 border-t border-neutral-200 pt-4 text-center font-sans text-[13px] leading-[1.7] text-neutral-500">{{ section.settings.delivery_note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} accordions {%- endcomment -%}
        <div class="mt-8">
          <details open class="border-b border-neutral-100">
            <summary class="flex cursor-pointer list-none items-center justify-between py-5 font-sans text-[14px] text-black [&::-webkit-details-marker]:hidden">
              {{ 'products.product.details' | t }}
              {% render 'icon', name: 'chevron-down', class: 'h-3.5 w-3.5 transition-transform duration-200 open:rotate-180' %}
            </summary>
            <div class="space-y-4 pb-6 font-sans text-[16px] leading-[1.75] text-neutral-600">
              {%- if product.description != blank -%}
                <div class="rte">{{ product.description }}</div>
              {%- endif -%}
              <p>{{ 'products.product.canvas_line' | t }}</p>
            </div>
          </details>
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <details class="border-b border-neutral-100" {{ block.shopify_attributes }}>
                <summary class="flex cursor-pointer list-none items-center justify-between py-5 font-sans text-[14px] text-black [&::-webkit-details-marker]:hidden">
                  {{ block.settings.heading }}
                  {% render 'icon', name: 'chevron-down', class: 'h-3.5 w-3.5 transition-transform duration-200 open:rotate-180' %}
                </summary>
                <div class="space-y-4 pb-6 font-sans text-[16px] leading-[1.75] text-neutral-600">
                  <div class="rte">{{ block.settings.content }}</div>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} feature icons {%- endcomment -%}
  {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
  {%- if feature_blocks.size > 0 -%}
    <div class="mt-12 grid grid-cols-2 gap-6 border-t border-neutral-100 pt-8 lg:grid-cols-4" data-product-trust>
      {%- for block in feature_blocks -%}
        {%- assign trust_title = block.settings.heading | default: block.settings.text -%}
        <div class="min-w-0 text-center" data-trust-item {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon, class: 'mx-auto h-5 w-5 text-black' %}
          <h3 class="mt-3 font-sans text-[14px] font-medium leading-[1.4] text-black">{{ trust_title | escape }}</h3>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- comment -%} mobile sticky ATC bar {%- endcomment -%}
<sticky-atc
  data-add-text="{{ 'products.product.add_to_cart' | t }}"
  data-sold-out-text="{{ 'products.product.sold_out' | t }}"
  aria-hidden="true"
  class="invisible fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-neutral-200 bg-white transition-[transform,visibility] duration-300 lg:hidden"
>
  <div class="flex items-center gap-3 px-4 py-3 [padding-bottom:max(0.75rem,env(safe-area-inset-bottom))]">
    {%- if master != blank -%}
      <frame-preview aspect="{{ aspect }}" class="block h-12 w-11 flex-none">
        {% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: '', sizes: '44px', class: 'h-12 w-11' %}
      </frame-preview>
    {%- endif -%}
    <div class="min-w-0 flex-1">
      <p class="truncate font-sans text-[14px] text-black">{{ product.title }}</p>
      <p class="mt-0.5 font-sans text-[14px] text-neutral-500">
        <s data-sticky-compare class="mr-1.5 text-neutral-400{% unless on_sale %} hidden{% endunless %}">{% if on_sale %}<span data-display-money data-cents="{{ cv.compare_at_price }}">{{ cv.compare_at_price | money }}</span>{% endif %}</s>
        <span data-sticky-price><span data-display-money data-cents="{{ current_variant.price }}">{{ current_variant.price | money }}</span></span>
      </p>
    </div>
    <button
      type="button"
      data-sticky-button
      class="flex h-11 flex-none items-center gap-2 bg-black px-5 font-sans text-[14px] text-white transition-opacity hover:opacity-80 {% unless current_variant.available %}opacity-30{% endunless %}"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {% render 'icon', name: 'bag', class: 'h-3.5 w-3.5' %}
      <span data-sticky-button-text>
        {%- if current_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>
  </div>
</sticky-atc>

{%- comment -%} size guide: real scale visualizer {%- endcomment -%}
{% render 'size-guide', product: product %}

{%- comment -%} image lightbox (skipped for products without media) {%- endcomment -%}
{%- if master != blank -%}
<image-lightbox class="lightbox-in fixed inset-0 z-[80] hidden bg-[#ebedea]" role="dialog" aria-modal="true" aria-label="{{ 'products.product.open_viewer' | t }}">
  <button type="button" data-lightbox-close aria-label="{{ 'general.close' | t }}" class="absolute right-5 top-5 z-20 -m-2 p-2 text-black transition-opacity hover:opacity-50">
    {% render 'icon', name: 'x', class: 'h-6 w-6' %}
  </button>

  {%- comment -%} single zoomable stage: wheel/pinch/double-tap zoom in place, backdrop tap closes {%- endcomment -%}
  <div data-lightbox-stage class="absolute inset-0 flex touch-none items-center justify-center overflow-hidden p-6 pb-24 pt-16 md:p-20">
    <img src="{{ master | image_url: width: 2048 }}" alt="{{ product.title | escape }}" data-lightbox-current draggable="false" class="max-h-full max-w-full select-none object-contain transition-transform duration-200 will-change-transform" width="{{ master.width }}" height="{{ master.height }}">
  </div>

  {%- if slide_count > 1 -%}
    <button type="button" data-lightbox-prev aria-label="{{ 'products.product.previous_image' | t }}" class="absolute left-5 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-black shadow-sm backdrop-blur-xs transition-opacity hover:opacity-80 lg:flex">
      {% render 'icon', name: 'chevron-left', class: 'h-4 w-4' %}
    </button>
    <button type="button" data-lightbox-next aria-label="{{ 'products.product.next_image' | t }}" class="absolute right-5 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-black shadow-sm backdrop-blur-xs transition-opacity hover:opacity-80 lg:right-[4.5rem] lg:flex">
      {% render 'icon', name: 'chevron-right', class: 'h-4 w-4' %}
    </button>
  {%- endif -%}

  {%- if slide_count > 1 -%}
    <div class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 gap-2 md:bottom-auto md:left-auto md:right-5 md:top-1/2 md:-translate-x-0 md:-translate-y-1/2 md:flex-col">
      <button type="button" data-lightbox-thumb aria-label="{{ 'products.product.show_image' | t: index: 1 }}" class="h-8 w-8 flex-none overflow-hidden border border-black bg-white transition-colors md:h-9 md:w-9">
        {% if gallery_lead.id != master.id %}{% render 'artwork-scene', scene_layouts: product.metafields.custom.scene_layouts.value, room: gallery_lead, master: master, aspect: aspect, frame: frame_val, alt: product.title, thumbnail: true, loading: 'eager' %}{% else %}<frame-preview class="block h-full w-full">
          {% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: '', sizes: '36px', class: 'h-full w-full' %}
        </frame-preview>{% endif %}
      </button>
      {%- assign t_index = 2 -%}
      {%- for m in gallery_remaining -%}
        {%- if m.media_type != 'image' -%}
          {%- continue -%}
        {%- endif -%}
        <button type="button" data-lightbox-thumb aria-label="{{ 'products.product.show_image' | t: index: t_index }}" class="h-8 w-8 flex-none overflow-hidden border border-black/15 bg-white transition-colors hover:border-black/40 md:h-9 md:w-9">
          {%- if m.id == master.id -%}<frame-preview class="block h-full w-full">{% render 'frame-preview', master: master, aspect: aspect, frame: frame_val, alt: product.title, class: 'h-full w-full' %}</frame-preview>{%- elsif m.alt == 'scene-room-v1' or m.alt == 'scene-room-large-v1' or m.alt == 'scene-room-large-v2' or m.alt contains 'composed-unframed-' -%}
            {% render 'artwork-scene', scene_layouts: product.metafields.custom.scene_layouts.value, room: m, master: master, aspect: aspect, frame: frame_val, alt: '', thumbnail: true %}
          {%- else -%}
            <img src="{{ m | image_url: width: 200 }}" alt="" class="h-full w-full object-cover" loading="lazy" width="{{ m.width }}" height="{{ m.height }}">
          {%- endif -%}
        </button>
        {%- assign t_index = t_index | plus: 1 -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <script type="application/json" data-lightbox-images>
    [
      { "src": {{ gallery_lead | image_url: width: 2048 | json }}, "alt": {{ product.title | json }}, "width": {{ gallery_lead.width | default: 2048 }}, "height": {{ gallery_lead.height | default: 2048 }} }
      {%- for m in gallery_remaining -%}
        {%- if m.media_type != 'image' -%}
          {%- continue -%}
        {%- endif -%}
        , { "src": {{ m | image_url: width: 2048 | json }}, "alt": {{ product.title | json }}, "width": {{ m.width | default: 2048 }}, "height": {{ m.height | default: 2048 }} }
      {%- endfor -%}
    ]
  </script>
</image-lightbox>
{%- endif -%}

{% schema %}
{
  "name": "商品",
  "settings": [
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "主图盒比例",
      "info": "画廊主图盒的固定宽高比，桌面端与移动端均生效；画作在盒内仍按所选尺码真实缩放。",
      "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "正方形 1:1" },
        { "value": "4 / 5", "label": "竖版 4:5" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_delivery_estimate",
      "label": "显示送达时间预估",
      "default": true,
      "info": "加购按钮下方显示三节点时间线：下单 → 绘制完成 → 预计送达（完成后即发货）。"
    },
    {
      "type": "textarea",
      "id": "delivery_note",
      "label": "时间线底部说明",
      "default": "Every piece is painted to order, then shipped fully insured from China. Estimated delivery is approximately 2–3 weeks. Duties and taxes for normal delivery are included in the purchase price."
    },
    {
      "type": "number",
      "id": "production_days_min",
      "label": "制作周期下限（天）",
      "default": 7
    },
    {
      "type": "number",
      "id": "production_days_max",
      "label": "制作周期上限（天）",
      "default": 10
    },
    {
      "type": "number",
      "id": "transit_days_min",
      "label": "运输时效下限（天）",
      "default": 5
    },
    {
      "type": "number",
      "id": "transit_days_max",
      "label": "运输时效上限（天）",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "手风琴行",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Packaging"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "内容",
          "info": "「Painting details」（描述+尺寸）为内置内容，始终显示在第一行。"
        }
      ]
    },
    {
      "type": "feature",
      "name": "特性图标",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "图标",
          "default": "rotate-ccw",
          "options": [
            {
              "value": "check",
              "label": "确认"
            },
            {
              "value": "truck",
              "label": "配送"
            },
            {
              "value": "rotate-ccw",
              "label": "退货／撤销"
            },
            {
              "value": "shield-check",
              "label": "品质"
            },
            {
              "value": "layers",
              "label": "肌理"
            },
            {
              "value": "frame",
              "label": "装裱"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "info": "留空时保留原有的单段正文样式。"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "正文",
          "info": "保留换行，两行短句效果最佳。",
          "default": "Feature"
        }
      ]
    }
  ]
}
{% endschema %}
