{%- paginate collections by 24 -%}
  <div class="px-5 py-12 md:px-10">
    <div class="max-w-md">
      <h1 class="font-serif text-[32px] text-black md:text-[36px]">{{ 'collections.list_title' | t }}</h1>
      <p class="mt-4 font-serif text-[17px] leading-[1.45] text-black">{{ 'collections.list_intro' | t }}</p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="group">
          <div class="aspect-[4/5] w-full overflow-hidden bg-[#f3f3f3]">
            {%- if collection.image -%}
              <img
                src="{{ collection.image | image_url: width: 800 }}"
                srcset="{{ collection.image | image_url: width: 400 }} 400w, {{ collection.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 1024px) 25vw, 50vw"
                alt="{{ collection.title | escape }}"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                loading="lazy"
                width="{{ collection.image.width }}"
                height="{{ collection.image.height }}"
              >
            {%- elsif collection.products.first.featured_media -%}
              <img
                src="{{ collection.products.first.featured_media | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                loading="lazy"
                width="{{ collection.products.first.featured_media.width }}"
                height="{{ collection.products.first.featured_media.height }}"
              >
            {%- endif -%}
          </div>
          <p class="mt-3 font-sans text-[14px] leading-snug text-black">{{ collection.title }}</p>
          <p class="mt-1 font-sans text-[14px] leading-snug text-neutral-500">
            {{ 'collections.works_count' | t: count: collection.products_count }}
          </p>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="mt-12 flex items-center justify-center gap-2 font-sans text-[14px]" aria-label="{{ 'general.pagination' | t }}">
        {%- assign current_str = paginate.current_page | append: '' -%}
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}" class="flex h-8 w-8 items-center justify-center text-black transition-opacity hover:opacity-50">
            {% render 'icon', name: 'chevron-left', class: 'h-4 w-4' %}
          </a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="flex h-8 w-8 items-center justify-center text-black transition-opacity hover:opacity-50">{{ part.title }}</a>
          {%- elsif part.title == current_str -%}
            <span class="flex h-8 w-8 items-center justify-center bg-black text-white" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="flex h-8 w-8 items-center justify-center text-neutral-500">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}" class="flex h-8 w-8 items-center justify-center text-black transition-opacity hover:opacity-50">
            {% render 'icon', name: 'chevron-right', class: 'h-4 w-4' %}
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "合集列表",
  "settings": []
}
{% endschema %}
