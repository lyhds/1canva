{%- if section.blocks.size > 0 -%}
  <section class="px-3 md:px-6">
    <div class="grid grid-cols-2 gap-x-4 gap-y-9 px-4 py-9 md:grid-cols-4 md:gap-x-6 md:px-10 md:py-11">
      {%- for block in section.blocks -%}
        <div class="flex flex-col items-center text-center" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon, class: 'h-6 w-6 flex-none text-black' %}
          {%- if block.settings.title != blank -%}
            <p class="mt-3.5 font-sans text-[13px] font-medium text-black">{{ block.settings.title }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="mt-1.5 font-sans text-[12px] leading-[1.6] text-neutral-600">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "保障条",
  "settings": [],
  "blocks": [
    {
      "type": "assurance",
      "name": "保障项",
