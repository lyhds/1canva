<script src="{{ 'slider.js' | asset_url }}" defer></script>

{%- if section.blocks.size > 0 -%}
  <section class="pb-16 md:pb-24">
    <h2 class="px-5 font-serif text-[28px] text-black md:px-10 md:text-[32px]">{{ section.settings.heading }}</h2>

    <slider-component class="group relative mt-8 block">
      <div data-slider-track class="scrollbar-hide flex gap-5 overflow-x-auto px-5 md:px-10">
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign cover_asset = block.settings.cover_asset -%}
          <div data-slider-item class="relative w-[75%] flex-none sm:w-[45%] lg:w-auto" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: col.url | default: routes.all_products_collection_url }}" class="group block">
              <div class="aspect-[4/5] w-full overflow-hidden bg-[#f3f3f3] lg:h-[60vh] lg:w-auto">
                {%- if block.settings.image -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    alt="{{ block.settings.image.alt | default: col.title | escape }}"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {%- elsif cover_asset != blank -%}
                  <img
                    src="{{ cover_asset | asset_url }}"
                    alt="{{ col.title | default: 'Room inspiration' | escape }}"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                    width="1122"
                    height="1402"
                  >
                {%- elsif col.image -%}
                  <img
                    src="{{ col.image | image_url: width: 1200 }}"
                    alt="{{ col.title | escape }}"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                    width="{{ col.image.width }}"
                    height="{{ col.image.height }}"
                  >
                {%- elsif col.products.first.featured_media -%}
                  <img
                    src="{{ col.products.first.featured_media | image_url: width: 1200 }}"
                    alt="{{ col.title | escape }}"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                    width="{{ col.products.first.featured_media.width }}"
                    height="{{ col.products.first.featured_media.height }}"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'h-full w-full bg-neutral-100' }}
                {%- endif -%}
              </div>
              <span class="absolute bottom-3 left-3 bg-black/45 px-2.5 py-1 font-sans text-[13px] text-white backdrop-blur-xs transition-colors group-hover:bg-black/65">
                {{ block.settings.link_label | default: col.title | default: 'Shop the room' }}
              </span>
            </a>
          </div>
        {%- endfor -%}
      </div>
      <button type="button" data-slider-prev aria-label="{{ 'general.previous' | t }}" class="absolute left-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-black opacity-0 shadow-sm backdrop-blur-xs transition-opacity duration-200 hover:bg-white group-hover:opacity-100 lg:flex" style="display:none">
        {% render 'icon', name: 'chevron-left', class: 'h-4 w-4' %}
      </button>
      <button type="button" data-slider-next aria-label="{{ 'general.next' | t }}" class="absolute right-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-black opacity-0 shadow-sm backdrop-blur-xs transition-opacity duration-200 hover:bg-white group-hover:opacity-100 lg:flex">
        {% render 'icon', name: 'chevron-right', class: 'h-4 w-4' %}
      </button>
    </slider-component>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "按房间选购",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Shop by room"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "房间",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "合集",
          "info": "整张卡片默认链接到这个合集。"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片覆盖",
          "info": "可选，建议使用约 4:5 的竖版图。"
        },
        {
          "type": "text",
          "id": "cover_asset",
          "label": "主题封面文件",
          "info": "使用主题 assets 中的图片文件名；上传的图片覆盖优先。"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "链接文字",
          "default": "Shop the room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "按房间选购",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
