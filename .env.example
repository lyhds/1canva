# Canvasra theme + Product Studio environment.
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Shopify Admin API -------------------------------------------------------
# Create the app in the Dev Dashboard (dev.shopify.com): since 2026-01-01 the
# Shopify Admin "Develop apps" entry point can no longer create new custom apps
# (existing legacy apps keep working). Create the app, publish a version with
# the scopes below, install it on the store, then copy the Client ID and secret.
# Scopes needed: read_products, write_products, read_files, write_files,
#                read_publications, write_publications, read_inventory,
#                write_inventory, read_content, write_content.
# For Shopify CLI theme work (theme dev/push/pull) also add read_themes and
# write_themes. The CLI never reads this file: it authenticates through
# `shopify auth login`, or through SHOPIFY_CLI_THEME_TOKEN + SHOPIFY_FLAG_STORE.
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Admin API version used by Product Studio. Shopify ships a new version every
# quarter and supports each one for at least 12 months; 2025-07 was retired on
# 2026-07-16. Check https://shopify.dev/docs/api/usage/versioning before pinning.
SHOPIFY_API_VERSION=2026-01

# --- Store identity guard ----------------------------------------------------
# Product Studio refuses to read or write unless the shop returned by the Admin
# API matches these two values, so a stale credential can never touch a
# different storefront.
SHOPIFY_STOREFRONT_HOST=canvasra.com
SHOPIFY_CURRENCY=USD

# --- Optional local overrides ------------------------------------------------
# STUDIO_PORT=4310
# CANVASRA_SCENE_LESSONS=
# CANVASRA_PYTHON=
# CANVASRA_BROWSER_CHANNEL=
