# Canvasra theme + Product Studio environment.
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Shopify Admin API -------------------------------------------------------
# Create a custom app: Shopify Admin -> Settings -> Apps and sales channels ->
# Develop apps -> Create an app -> Configure Admin API scopes, then install it
# and copy the Client credentials grant values below.
# Scopes needed: read_products, write_products, read_files, write_files,
#                read_publications, write_publications, read_inventory,
#                write_inventory, read_content, write_content.
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Admin API version used by Product Studio.
SHOPIFY_API_VERSION=2025-07

# --- Store identity guard ----------------------------------------------------
# Product Studio refuses to read or write unless the shop returned by the Admin
# API matches these two values, so a stale credential can never touch a
# different storefront.
SHOPIFY_STOREFRONT_HOST=canvasra.com
SHOPIFY_CURRENCY=USD

# --- Optional local overrides ------------------------------------------------
# STUDIO_PORT=4310
# CANVASRA_SCENE_LESSONS=
# CANVASRA_PYTHON=
# CANVASRA_BROWSER_CHANNEL=
