{%- doc -%}
  Product structured data (schema.org/Product) for rich search results:
  all variants as offers with price, currency and availability.
{%- enddoc -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- if product.featured_media -%}
      "image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- comment -%}most variants carry no SKU; a literal "sku": null is invalid structured data{%- endcomment -%}
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "url": {{ request.origin | append: variant.url | json }},
          "price": {{ variant.price | divided_by: 100.0 | round: 2 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
    {%- comment -%} aggregate rating only when the product has reviews (Google rejects empty/zero ratings) {%- endcomment -%}
    {%- assign review_refs = product.metafields.custom.reviews.value -%}
    {%- if settings.enable_customer_reviews and review_refs != blank -%}
      {%- assign r_count = 0 -%}
      {%- assign r_sum = 0 -%}
      {%- for r in review_refs -%}
        {%- if r.rating -%}
          {%- assign r_count = r_count | plus: 1 -%}
          {%- assign r_sum = r_sum | plus: r.rating -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if r_count > 0 -%}
        {%- assign r_avg = r_sum | times: 1.0 | divided_by: r_count | round: 1 -%}
        ,
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ r_avg | json }},
          "reviewCount": {{ r_count | json }},
          "bestRating": 5,
          "worstRating": 1
        },
        "review": [
          {%- assign r_printed = 0 -%}
          {%- for r in review_refs -%}
            {%- if r.rating -%}
              {%- if r_printed > 0 -%},{%- endif -%}
              {%- capture r_body_text -%}{{ r.body }}{%- endcapture -%}
              {
                "@type": "Review",
                "author": { "@type": "Person", "name": {{ r.author | json }} },
                {%- if r.date != blank -%}
                  "datePublished": {{ r.date | date: '%Y-%m-%d' | json }},
                {%- endif -%}
                {%- if r.title != blank -%}
                  "name": {{ r.title | json }},
                {%- endif -%}
                {%- if r.body != blank -%}
                  "reviewBody": {{ r_body_text | json }},
                {%- endif -%}
                "reviewRating": { "@type": "Rating", "ratingValue": {{ r.rating | json }}, "bestRating": 5, "worstRating": 1 }
              }
              {%- assign r_printed = r_printed | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      {%- endif -%}
    {%- endif -%}
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} }
      {%- assign breadcrumb_collection = collection | default: product.collections.first -%}
      {%- if breadcrumb_collection -%}
        , { "@type": "ListItem", "position": 2, "name": {{ breadcrumb_collection.title | json }}, "item": {{ request.origin | append: breadcrumb_collection.url | json }} }
        , { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
      {%- else -%}
        , { "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
      {%- endif -%}
    ]
  }
</script>
