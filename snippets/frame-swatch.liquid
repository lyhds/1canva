{%- doc -%}
  Maps a Frame option value to its swatch asset filename. Blank output
  represents canvas-only delivery rather than an outer float frame. Legacy
  aliases resolve through the shared frame-key snippet.

  @param frame {string} frame delivery option
{%- enddoc -%}
{%- liquid
  assign frame_key = ''
  capture frame_key
    render 'frame-key', frame: frame
  endcapture
  assign frame_key = frame_key | strip
  case frame_key
    when 'oak'
      echo 'oak-swatch.webp'
    when 'black'
      echo 'black-swatch.webp'
    when 'walnut'
      echo 'walnut-swatch.webp'
    when 'white'
      echo 'white-swatch.webp'
    when 'gold'
      echo 'gold-swatch.webp'
    when 'silver'
      echo 'silver-swatch.webp'
  endcase
-%}
